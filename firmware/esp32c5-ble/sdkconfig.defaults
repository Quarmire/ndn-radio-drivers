# ESP32-C5 named-radio BLE bearer: NimBLE extended advertising + scanning, host-driven over USB-Serial-JTAG.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# BLE 5 extended advertising + extended scanning (the 245-byte payload path — legacy 31B can't carry NDN).
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=1
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Not a peripheral/central — connectionless broadcast only (the named-radio model).
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
# Room for a 254-byte ext-adv payload.
CONFIG_BT_NIMBLE_MAX_EXT_ADV_DATA_LEN=254
# Console on USB-Serial-JTAG (keeps esptool auto-reset), logs OFF so ESP_LOG can't corrupt the binary
# ND protocol stream (same rule as the Wi-Fi firmware). Never CONSOLE_NONE (breaks output AND auto-reset).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
